{
  "family": "mimapasos-backend-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::658872312760:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::658872312760:role/ecsTaskRole",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "mimapasos-backend-container",
      "image": "IMAGE_PLACEHOLDER_REPLACED_BY_GITHUB_ACTIONS",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5001,
          "hostPort": 5001,
          "protocol": "tcp"
        },
        {
          "containerPort": 5002,
          "hostPort": 5002,
          "protocol": "tcp"
        },
        {
          "containerPort": 5003,
          "hostPort": 5003,
          "protocol": "tcp"
        },
        {
          "containerPort": 5004,
          "hostPort": 5004,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PYTHONUNBUFFERED",
          "value": "1"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:us-east-1:658872312760:parameter/mimapasos/DATABASE_URL"
        },
        {
          "name": "DIRECT_URL",
          "valueFrom": "arn:aws:ssm:us-east-1:658872312760:parameter/mimapasos/DIRECT_URL"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mimapasos-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}